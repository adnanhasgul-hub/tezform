rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function anonymous() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function nonAnonymous() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function admin() {
      return nonAnonymous() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function uuid(value) {
      return value is string && value.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }
    function subjectId(value) {
      return value is string && value.matches('^[A-Za-z0-9]{20}$');
    }
    function code(number) {
      return number < 10 ? 'AHT-00' + string(number)
        : number < 100 ? 'AHT-0' + string(number)
        : 'AHT-' + string(number);
    }
    function validNumber(number) {
      return number is int && number >= 0 && number <= 9007199254740991;
    }
    function validCounter(data) {
      return data.keys().hasAll(['lastAllocatedNumber', 'lastSubjectId', 'lastRequestId', 'lastCreatedByUid'])
        && data.keys().hasOnly(['lastAllocatedNumber', 'lastSubjectId', 'lastRequestId', 'lastCreatedByUid'])
        && validNumber(data.lastAllocatedNumber)
        && subjectId(data.lastSubjectId) && uuid(data.lastRequestId)
        && data.lastCreatedByUid == request.auth.uid;
    }
    function validPublic(data) {
      return data is map
        && data.keys().hasAll(["nationalId", "protocolDate", "sex", "age", "weight", "height", "bmi", "indication", "indicationOther", "dailyDose", "dailyDoseOther", "treatmentDurationYears", "treatmentDurationMonths", "adherence", "lastDoseTime", "otherAntithrombotic", "nsaid", "nsaidFrequency", "inhibitors", "inducers", "bruising", "bruisingSize", "gingivalBleeding", "gingivalDuration", "epistaxis", "epistaxisFrequency", "epistaxisDuration", "cutBleeding", "melena", "hematochezia", "hematemesis", "hematuria", "menorrhagia", "headache", "neurologicalSymptoms", "hemarthrosis", "hemoptysis", "subconjunctivalBleeding", "healthcareVisit", "healthcareVisitType", "transfusion", "transfusionUnits", "treatmentInterruption", "interruptionDays", "hemoglobinDrop", "bleedingOnsetInterval", "bleedingDayDose", "researchNotes", "investigatorName", "treatmentDurationTotalMonths"])
        && data.keys().hasOnly(["nationalId", "protocolDate", "sex", "age", "weight", "height", "bmi", "indication", "indicationOther", "dailyDose", "dailyDoseOther", "treatmentDurationYears", "treatmentDurationMonths", "adherence", "lastDoseTime", "otherAntithrombotic", "nsaid", "nsaidFrequency", "inhibitors", "inducers", "bruising", "bruisingSize", "gingivalBleeding", "gingivalDuration", "epistaxis", "epistaxisFrequency", "epistaxisDuration", "cutBleeding", "melena", "hematochezia", "hematemesis", "hematuria", "menorrhagia", "headache", "neurologicalSymptoms", "hemarthrosis", "hemoptysis", "subconjunctivalBleeding", "healthcareVisit", "healthcareVisitType", "transfusion", "transfusionUnits", "treatmentInterruption", "interruptionDays", "hemoglobinDrop", "bleedingOnsetInterval", "bleedingDayDose", "researchNotes", "investigatorName", "treatmentDurationTotalMonths"])
        && data.nationalId is string
        && data.protocolDate is string
        && data.sex is string
        && data.age is string
        && data.weight is string
        && data.height is string
        && data.indication is string
        && data.indicationOther is string
        && data.dailyDose is string
        && data.dailyDoseOther is string
        && data.adherence is string
        && data.lastDoseTime is string
        && data.nsaid is string
        && data.nsaidFrequency is string
        && data.bruising is string
        && data.bruisingSize is string
        && data.gingivalBleeding is string
        && data.gingivalDuration is string
        && data.epistaxis is string
        && data.epistaxisFrequency is string
        && data.epistaxisDuration is string
        && data.cutBleeding is string
        && data.melena is string
        && data.hematochezia is string
        && data.hematemesis is string
        && data.hematuria is string
        && data.menorrhagia is string
        && data.headache is string
        && data.neurologicalSymptoms is string
        && data.hemarthrosis is string
        && data.hemoptysis is string
        && data.subconjunctivalBleeding is string
        && data.healthcareVisit is string
        && data.healthcareVisitType is string
        && data.transfusion is string
        && data.transfusionUnits is string
        && data.treatmentInterruption is string
        && data.interruptionDays is string
        && data.hemoglobinDrop is string
        && data.bleedingOnsetInterval is string
        && data.bleedingDayDose is string
        && data.researchNotes is string
        && data.investigatorName is string
        && data.otherAntithrombotic is list
        && data.otherAntithrombotic.toSet().size() == data.otherAntithrombotic.size()
        && data.otherAntithrombotic.hasOnly(['Hayır', 'Aspirin', 'Klopidogrel / Tikagrelor', 'Heparin'])
        && data.inhibitors is list
        && data.inhibitors.toSet().size() == data.inhibitors.size()
        && data.inhibitors.hasOnly(['Amiodaron', 'Verapamil', 'Diltiazem', 'Ketokonazol / Itrakonazol', 'Klaritromisin', 'Hiçbiri'])
        && data.inducers is list
        && data.inducers.toSet().size() == data.inducers.size()
        && data.inducers.hasOnly(['Rifampisin', 'Karbamazepin', 'Fenitoin', "Sarı Kantaron (St. John's Wort)", 'Hiçbiri'])
        && (data.bmi == null || ((data.bmi is int || data.bmi is float) && data.bmi >= 0))
        && (data.treatmentDurationYears == null || (data.treatmentDurationYears is int && data.treatmentDurationYears >= 0))
        && (data.treatmentDurationMonths == null || (data.treatmentDurationMonths is int && data.treatmentDurationMonths >= 0 && data.treatmentDurationMonths <= 11))
        && ((data.treatmentDurationYears == null || data.treatmentDurationMonths == null)
          ? data.treatmentDurationTotalMonths == null
          : data.treatmentDurationTotalMonths is int && data.treatmentDurationTotalMonths == data.treatmentDurationYears * 12 + data.treatmentDurationMonths);
    }
    function validSubject(data) {
      return data.keys().hasAll(['subjectCode', 'subjectNumber', 'status', 'createdAt', 'updatedAt', 'createdByUid', 'requestId', 'publicValues', 'investigations'])
        && data.keys().hasOnly(['subjectCode', 'subjectNumber', 'status', 'createdAt', 'updatedAt', 'createdByUid', 'requestId', 'publicValues', 'investigations'])
        && validNumber(data.subjectNumber) && data.subjectCode == code(data.subjectNumber)
        && data.status == 'pending_completion'
        && data.createdAt == request.time && data.updatedAt == request.time
        && data.createdByUid == request.auth.uid && uuid(data.requestId)
        && data.investigations is map && data.investigations.size() == 0
        && validPublic(data.publicValues);
    }
    function shortText(value) {
      return value is string && value.size() <= 32;
    }
    function validInvestigations(data) {
      return data is map
        && data.keys().hasAll(['dvtLocations', 'dvtSide', 'bun', 'creatinine', 'egfr', 'calcium', 'sodium', 'potassium', 'totalBilirubin', 'directBilirubin', 'ast', 'alt', 'totalProtein', 'albumin', 'wbc', 'hemoglobin', 'platelets', 'hct', 'pt', 'inr', 'aptt'])
        && data.keys().hasOnly(['dvtLocations', 'dvtSide', 'bun', 'creatinine', 'egfr', 'calcium', 'sodium', 'potassium', 'totalBilirubin', 'directBilirubin', 'ast', 'alt', 'totalProtein', 'albumin', 'wbc', 'hemoglobin', 'platelets', 'hct', 'pt', 'inr', 'aptt'])
        && data.dvtLocations is list
        && data.dvtLocations.toSet().size() == data.dvtLocations.size()
        && data.dvtLocations.hasOnly(['İliak', 'Femoral', 'Popliteal', 'Üst Ekstremite', 'IVC', 'SVC', 'Juguler'])
        && data.dvtSide is list
        && data.dvtSide.toSet().size() == data.dvtSide.size()
        && data.dvtSide.hasOnly(['Sağ', 'Sol'])
        && shortText(data.bun)
        && shortText(data.creatinine)
        && shortText(data.egfr)
        && shortText(data.calcium)
        && shortText(data.sodium)
        && shortText(data.potassium)
        && shortText(data.totalBilirubin)
        && shortText(data.directBilirubin)
        && shortText(data.ast)
        && shortText(data.alt)
        && shortText(data.totalProtein)
        && shortText(data.albumin)
        && shortText(data.wbc)
        && shortText(data.hemoglobin)
        && shortText(data.platelets)
        && shortText(data.hct)
        && shortText(data.pt)
        && shortText(data.inr)
        && shortText(data.aptt);
    }
    function investigationsComplete(data) {
      return data.dvtLocations.size() > 0 && data.dvtSide.size() > 0
        && data.bun.matches('.*\\S.*')
        && data.creatinine.matches('.*\\S.*')
        && data.egfr.matches('.*\\S.*')
        && data.calcium.matches('.*\\S.*')
        && data.sodium.matches('.*\\S.*')
        && data.potassium.matches('.*\\S.*')
        && data.totalBilirubin.matches('.*\\S.*')
        && data.directBilirubin.matches('.*\\S.*')
        && data.ast.matches('.*\\S.*')
        && data.alt.matches('.*\\S.*')
        && data.totalProtein.matches('.*\\S.*')
        && data.albumin.matches('.*\\S.*')
        && data.wbc.matches('.*\\S.*')
        && data.hemoglobin.matches('.*\\S.*')
        && data.platelets.matches('.*\\S.*')
        && data.hct.matches('.*\\S.*')
        && data.pt.matches('.*\\S.*')
        && data.inr.matches('.*\\S.*')
        && data.aptt.matches('.*\\S.*')
        ;
    }
    function validAdminEdit(before, after) {
      return admin()
        && after.diff(before).affectedKeys().hasOnly(['publicValues', 'investigations', 'status', 'updatedAt'])
        && after.updatedAt == request.time
        && validPublic(after.publicValues)
        && validInvestigations(after.investigations)
        && after.status == (investigationsComplete(after.investigations) ? 'completed' : 'pending_completion');
    }
    function recentAdmin() {
      return admin() && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.auth_time is int
        && request.time.toMillis() / 1000 - request.auth.token.auth_time >= 0
        && request.time.toMillis() / 1000 - request.auth.token.auth_time <= 300;
    }
    function poolNumbers() {
      let path = /databases/$(database)/documents/systemCounters/reusableSubjects;
      return exists(path) ? get(path).data.numbers : [];
    }
    function validPool(data) {
      return data.keys().hasAll(['numbers', 'lastSubjectId', 'operation', 'insertIndex'])
        && data.keys().hasOnly(['numbers', 'lastSubjectId', 'operation', 'insertIndex'])
        && data.numbers is list && subjectId(data.lastSubjectId) && data.insertIndex is int;
    }
    function validAllocationNumber(subject, number, previous, next) {
      let path = /databases/$(database)/documents/systemCounters/reusableSubjects;
      let free = poolNumbers();
      return free.size() > 0
        ? number == free[0] && next == previous
          && validPool(getAfter(path).data)
          && getAfter(path).data.operation == 'allocate'
          && getAfter(path).data.lastSubjectId == subject
          && getAfter(path).data.insertIndex == -1
          && getAfter(path).data.numbers == free.removeAll([number])
        : number == previous + 1 && next == number
          && (exists(path) ? getAfter(path).data == get(path).data : !existsAfter(path));
    }
    // The previous list is sorted by induction. Removing the inserted value must
    // reproduce it exactly; checking adjacent values proves sorted insertion.
    function validRelease(subject, data) {
      let path = /databases/$(database)/documents/systemCounters/reusableSubjects;
      let free = poolNumbers();
      let after = getAfter(path).data;
      let index = after.insertIndex;
      let receiptPath = /databases/$(database)/documents/submissionRequests/$(data.createdByUid)/requests/$(data.requestId);
      return recentAdmin() && subjectId(subject) && validNumber(data.subjectNumber)
        && data.subjectNumber <= get(/databases/$(database)/documents/systemCounters/subjects).data.lastAllocatedNumber
        && !existsAfter(/databases/$(database)/documents/subjects/$(subject))
        && validPool(after) && after.operation == 'release' && after.lastSubjectId == subject
        && !free.hasAny([data.subjectNumber])
        && after.numbers.size() == free.size() + 1
        && after.numbers.toSet().size() == after.numbers.size()
        && index >= 0 && index < after.numbers.size()
        && after.numbers[index] == data.subjectNumber
        && after.numbers.removeAll([data.subjectNumber]) == free
        && (index == 0 || after.numbers[index - 1] < data.subjectNumber)
        && (index == after.numbers.size() - 1 || after.numbers[index + 1] > data.subjectNumber)
        && get(receiptPath).data.subjectId == subject
        && get(receiptPath).data.subjectNumber == data.subjectNumber
        && !get(receiptPath).data.keys().hasAny(['revoked'])
        && getAfter(receiptPath).data.revoked == true
        && getAfter(receiptPath).data.diff(get(receiptPath).data).affectedKeys().hasOnly(['revoked']);
    }
    function validReceipt(data, requestId) {
      return data.keys().hasAll(['subjectId', 'subjectCode', 'subjectNumber', 'requestId'])
        && data.keys().hasOnly(['subjectId', 'subjectCode', 'subjectNumber', 'requestId'])
        && subjectId(data.subjectId) && data.requestId == requestId && uuid(requestId)
        && validNumber(data.subjectNumber) && data.subjectCode == code(data.subjectNumber);
    }
    // All three documents must be new/coupled in one atomic allocation. The counter
    // is manually provisioned; clients cannot initialize/reset/delete it.
    function allocation(subject, requestId, number) {
      let counterPath = /databases/$(database)/documents/systemCounters/subjects;
      let subjectPath = /databases/$(database)/documents/subjects/$(subject);
      let receiptPath = /databases/$(database)/documents/submissionRequests/$(request.auth.uid)/requests/$(requestId);
      let previousCounter = get(counterPath).data;
      let nextCounter = getAfter(counterPath).data;
      let nextSubject = getAfter(subjectPath).data;
      let nextReceipt = getAfter(receiptPath).data;
      return previousCounter.lastAllocatedNumber is int && previousCounter.lastAllocatedNumber >= -1
        && !exists(subjectPath) && !exists(receiptPath)
        && validCounter(nextCounter)
        && validAllocationNumber(subject, number, previousCounter.lastAllocatedNumber, nextCounter.lastAllocatedNumber)
        && nextCounter.lastSubjectId == subject && nextCounter.lastRequestId == requestId
        && nextSubject.createdByUid == request.auth.uid && nextSubject.requestId == requestId
        && nextSubject.subjectNumber == number && nextSubject.subjectCode == code(number)
        && nextReceipt.subjectId == subject && nextReceipt.subjectNumber == number
        && nextReceipt.subjectCode == code(number) && nextReceipt.requestId == requestId;
    }
    match /systemCounters/subjects {
      allow get: if anonymous() || admin();
      allow list, create, delete: if false;
      allow update: if anonymous() && validCounter(request.resource.data)
        && allocation(request.resource.data.lastSubjectId, request.resource.data.lastRequestId, request.resource.data.lastAllocatedNumber);
    }
    match /systemCounters/reusableSubjects {
      allow get: if anonymous() || admin();
      allow list, delete: if false;
      allow create: if recentAdmin() && validRelease(request.resource.data.lastSubjectId,
        get(/databases/$(database)/documents/subjects/$(request.resource.data.lastSubjectId)).data);
      allow update: if (recentAdmin() && validRelease(request.resource.data.lastSubjectId,
        get(/databases/$(database)/documents/subjects/$(request.resource.data.lastSubjectId)).data))
        || (anonymous() && allocation(request.resource.data.lastSubjectId,
          getAfter(/databases/$(database)/documents/systemCounters/subjects).data.lastRequestId,
          getAfter(/databases/$(database)/documents/subjects/$(request.resource.data.lastSubjectId)).data.subjectNumber));
    }
    match /subjects/{id} {
      allow get, list: if admin();
      allow create: if anonymous() && subjectId(id) && validSubject(request.resource.data)
        && allocation(id, request.resource.data.requestId, request.resource.data.subjectNumber);
      allow update: if validAdminEdit(resource.data, request.resource.data);
      allow delete: if validRelease(id, resource.data);
    }
    match /submissionRequests/{uid}/requests/{id} {
      allow get: if admin() || (anonymous() && request.auth.uid == uid
        && (!exists(/databases/$(database)/documents/submissionRequests/$(uid)/requests/$(id))
          || !resource.data.keys().hasAny(['revoked'])));
      allow list, delete: if false;
      allow update: if recentAdmin()
        && uid == get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data.createdByUid
        && id == get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data.requestId
        && validRelease(resource.data.subjectId, get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data);
      allow create: if anonymous() && request.auth.uid == uid && validReceipt(request.resource.data, id)
        && allocation(request.resource.data.subjectId, id, request.resource.data.subjectNumber);
    }
    match /admins/{uid} {
      // Only the signed-in non-anonymous user can inspect their own marker,
      // including a missing marker. Marker provisioning is Console-only.
      allow get: if nonAnonymous() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
